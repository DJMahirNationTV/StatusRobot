### IDEs (IntelliJ & VS Code) ###
.idea/
*.iws
*.iml
*.ipr
out/
.vscode/

### ROOT & FRONTEND BLOCK (Node/JavaScript/OS) ###
# Ignoriert OS-Müll und Logfiles überall im Projekt
**/.DS_Store
**/*.log
**/logs/
**/npm-debug.log*
**/yarn-error.log*

# Ignoriert node_modules im Root UND im client-Ordner
node_modules/
client/node_modules/
bower_components/
client/bower_components/

# Ignoriert gebaute Frontend-Ordner
dist/
build/
client/dist/
client/build/

# Backup-Ordner
backup/

# Ignoriert .env im Root und in Unterordnern
.env
.env.*local
**/.env
**/.env.*local

### BACKEND BLOCK (Java Server) ###
# Kompilierten Code ignorieren
server/**/*.class
server/out/
server/target/
server/build/

# Paketierte Dateien (Archive)
server/**/*.jar
server/**/*.war
server/**/*.zip
server/**/*.tar.gz

# Java Absturz-Berichte (HotSpot VM)
server/hs_err_pid*
server/replay_pid*
